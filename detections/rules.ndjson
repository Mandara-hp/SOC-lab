{"id":"dfc25288-193b-4cf0-82b8-de44ae7da3a5","updated_at":"2026-11-12T00:00:41.086Z","updated_by":"elastic","created_at":"2026-11-12T00:00:41.086Z","created_by":"elastic","name":"Event Log Cleared","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Detects clearing of a Windows event log (1102 = Security audit log cleared; 104 = other log cleared). Log clearing is a common anti-forensics / track-covering technique and is rare in normal use. Data source: Windows Security/System logs.","risk_score":73,"severity":"high","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"b137933d-adfc-4302-8cb1-c35e607a00fd","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0005","name":"Defense Evasion","reference":"https://attack.mitre.org/tactics/TA0005"},"technique":[{"id":"T1070","name":"Indicator Removal","reference":"https://attack.mitre.org/techniques/T1070","subtechnique":[{"id":"T1070.001","name":"Clear Windows Event Logs","reference":"https://attack.mitre.org/techniques/T1070/001"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"event.code : \"1102\" or event.code : \"104\"","filters":[],"actions":[]}
{"id":"70859025-f69e-4a47-a44a-1f4421180ebf","updated_at":"2026-11-12T00:50:15.429Z","updated_by":"elastic","created_at":"2026-11-12T00:50:15.429Z","created_by":"elastic","name":"New Local User Account Created","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Detects creation of a new local user account (Event ID 4720, Security log). Attackers create accounts as a persistence backdoor. Rare in normal endpoint use. Data source: Windows Security log.","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"0994ef45-ccb2-4a04-9652-ca572c83a837","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003"},"technique":[{"id":"T1136","name":"Create Account","reference":"https://attack.mitre.org/techniques/T1136","subtechnique":[{"id":"T1136.001","name":"Local Account","reference":"https://attack.mitre.org/techniques/T1136/001"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"  event.code : \"4720\"","filters":[],"actions":[]}
{"id":"75c1e6eb-1216-4f51-95b4-5b4f1d4b08de","updated_at":"2026-11-09T02:10:36.548Z","updated_by":"elastic","created_at":"2026-11-09T02:10:36.548Z","created_by":"elastic","name":"Host Reconnaissance Burst","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Detects a burst of host/network reconnaissance commands (whoami, systeminfo, ipconfig, net, nltest, tasklist, hostname, arp) from a single host within the rule window. Any one is benign, but 4+ together is a common sign of an attacker enumerating a machine shortly after gaining access. Threshold: 4+ per host. Data source: Sysmon Event ID 1 / Windows process creation. MITRE: Discovery (T1082).","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"f0187d04-66ee-4b22-a0dc-7f9547cc8623","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0007","name":"Discovery","reference":"https://attack.mitre.org/tactics/TA0007"},"technique":[{"id":"T1082","name":"System Information Discovery","reference":"https://attack.mitre.org/techniques/T1082","subtechnique":[]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"threshold","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"  process.name : (\"whoami.exe\" or \"systeminfo.exe\" or \"ipconfig.exe\" or \"net.exe\" or \"net1.exe\" or \"nltest.exe\" or \"tasklist.exe\" or \"hostname.exe\" or \"arp.exe\")","filters":[],"threshold":{"field":["host.name"],"value":5,"cardinality":[]},"actions":[]}
{"id":"c5a09fd3-2833-4c62-9eeb-e6de26f9dfb0","updated_at":"2026-11-08T23:25:45.447Z","updated_by":"elastic","created_at":"2026-11-01T22:00:14.506Z","created_by":"elastic","name":"Suspicious Encoded PowerShell Execution","tags":[],"interval":"5m","enabled":true,"revision":2,"description":"Detects powershell.exe launched with an encoded command (-enc / -EncodedCommand). Attackers base64-encode PowerShell to hide their commands from log review. Legitimate admin use is rare. Data source: Sysmon Event ID 1 (process creation).","risk_score":73,"severity":"high","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"43a2e69a-6a2f-4a79-a119-8d76f6f57300","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002"},"technique":[{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059","subtechnique":[{"id":"T1059.001","name":"PowerShell","reference":"https://attack.mitre.org/techniques/T1059/001"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"process.name : (\"powershell.exe\" or \"pwsh.exe\") and process.command_line : (*-enc* or *-Enc* or *-ENC*)","filters":[],"actions":[]}
{"id":"75622c6e-288f-4d6b-bbe4-076d4a7b665a","updated_at":"2026-11-11T23:10:22.941Z","updated_by":"elastic","created_at":"2026-11-11T23:10:22.941Z","created_by":"elastic","name":"New Windows Service Installed","tags":[],"interval":"5m","enabled":true,"revision":0,"description":" Detects installation of a new Windows service (Event ID 7045, System log). Services run at SYSTEM and auto-start, so attackers abuse them for persistence, privilege escalation, and lateral movement (e.g. PsExec). Benign software also installs services → review the ImagePath. Data source: Windows System log.","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"b9a2ddd7-9541-4128-a70c-3d2a4f4b9754","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003"},"technique":[{"id":"T1543","name":"Create or Modify System Process","reference":"https://attack.mitre.org/techniques/T1543","subtechnique":[{"id":"T1543.003","name":"Windows Service","reference":"https://attack.mitre.org/techniques/T1543/003"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"  event.code : \"7045\"","filters":[],"actions":[]}
{"id":"0d8da718-2bc5-4ac8-82a7-55d215440ba9","updated_at":"2026-11-05T19:59:16.336Z","updated_by":"elastic","created_at":"2026-11-05T19:59:16.336Z","created_by":"elastic","name":"Possible Brute Force - Multiple Failed Logons","tags":[],"interval":"1m","enabled":true,"revision":0,"description":"Fires when a single host records 5 or more failed logon events (Windows Security Event ID 4625) within the rule window. Indicates possible password-guessing / brute-force activity. Data source: Windows Security log via System integration.","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"from":"5m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"92e5f2b0-1bc2-4e82-9284-1b91373b7e14","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0006","name":"Credential Access","reference":"https://attack.mitre.org/tactics/TA0006"},"technique":[{"id":"T1110","name":"Brute Force","reference":"https://attack.mitre.org/techniques/T1110","subtechnique":[]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"threshold","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"  event.code : \"4625\"","filters":[],"threshold":{"field":["host.name"],"value":5,"cardinality":[]},"actions":[]}
{"id":"1928acfe-bacd-40a0-ac9c-e9c47e5d5b82","updated_at":"2026-11-10T14:31:05.532Z","updated_by":"elastic","created_at":"2026-11-10T14:31:05.532Z","created_by":"elastic","name":"Registry run key persistance","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Detects writes to a CurrentVersion\\Run autostart registry key (Sysmon Event ID 13). Attackers add Run-key entries so their malware relaunches at every login. Benign software uses this too → review the data value. Data source: Sysmon registry events.","risk_score":73,"severity":"high","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"e4ee73e8-d635-4ca7-a302-9b9d99cabfc5","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003"},"technique":[{"id":"T1547","name":"Boot or Logon Autostart Execution","reference":"https://attack.mitre.org/techniques/T1547","subtechnique":[{"id":"T1547.001","name":"Registry Run Keys / Startup Folder","reference":"https://attack.mitre.org/techniques/T1547/001"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"  event.code : \"13\" and registry.path : *CurrentVersion* and registry.path : *Run*","filters":[],"actions":[]}
{"id":"8a616cfb-6a20-4993-8435-a8ff883b602d","updated_at":"2026-11-08T23:13:50.571Z","updated_by":"elastic","created_at":"2026-11-08T22:54:58.610Z","created_by":"elastic","name":"Certutil LOLBin Abuse - Download Cradle","tags":[],"interval":"5m","enabled":true,"revision":1,"description":"Detects certutil.exe run with the -urlcache flag, which downloads files from a URL. Certutil is a trusted built-in Windows tool; attackers abuse it as a download cradle to pull malware onto a host while blending in (living-off-the-land). Legitimate -urlcache use against external URLs is rare. Data source: Sysmon Event ID 1.","risk_score":73,"severity":"high","license":"","output_index":"","meta":{"from":"1m","kibana_siem_app_url":"http://172.16.181.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-360s","rule_id":"09b9ca5b-3ba6-42da-9cf6-2dc149b57995","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0011","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0011"},"technique":[{"id":"T1105","name":"Ingress Tool Transfer","reference":"https://attack.mitre.org/techniques/T1105","subtechnique":[]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"process.name : \"certutil.exe\" and process.command_line : *urlcache*","filters":[],"actions":[]}
